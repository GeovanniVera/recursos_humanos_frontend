# Copy to `.env` and adjust: `cp .env.example .env`
# The real `.env` is git-ignored; this template is the committed contract.

# Host port that publishes the container (http://localhost:${APP_PORT}).
APP_PORT=4200

# API origin compiled into the bundle at image build time.
# Changing it requires `docker compose up --build`.
API_BASE_URL=http://localhost:8080/api

# Tag for the locally built image.
IMAGE_TAG=local
